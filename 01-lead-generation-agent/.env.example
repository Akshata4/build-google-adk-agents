# Copy to .env and fill in values: cp .env.example .env

# --- Gemini (option 1: Google AI Studio API key) ---
# This agent makes ~35 model calls per run; the free tier (20/day) is not enough.
# Enable billing on the key's project in AI Studio.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=<your-api-key>

# --- Gemini (option 2: Vertex AI) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=<your-project-id>
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Models (optional) ---
# Fast model: formatting, validation, intent extraction.
# GEN_FAST_MODEL=gemini-2.5-flash
# Advanced model: root agent, research and synthesis.
# GEN_ADVANCED_MODEL=gemini-2.5-pro
