# Copy to .env and fill in values: cp .env.example .env

# --- ADK agent model (Google AI Studio key) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=<your-api-key>
# GEMINI_MODEL=gemini-2.5-flash

# --- Gemini CLI ---
# The CLI authenticates on its own: run `gemini` once in a terminal and pick
# "Login with Google" or "Use Gemini API Key"; headless runs reuse it.
# A key saved by the CLI lives in the OS keychain, which headless runs
# occasionally fail to read (error code 41). Setting it here avoids that:
# GEMINI_API_KEY=<your-gemini-cli-api-key>
# Path to the binary, if it's not on PATH:
# GEMINI_CLI_PATH=gemini
# Model for the CLI. List the ones your account can use: gemini --list-models
# ("auto" often lands on overloaded models and fails with 503s).
GEMINI_CLI_MODEL=gemini-3.1-flash-lite
# Seconds before a CLI call is stopped:
# GEMINI_CLI_TIMEOUT=600

# --- Workspace for cloned repositories (default: ./workspace) ---
# WORKSPACE_DIR=./workspace
