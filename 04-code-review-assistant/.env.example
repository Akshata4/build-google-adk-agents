# Copy to .env and fill in values: cp .env.example .env

# --- Model access (Google AI Studio key) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=<your-api-key>

# --- Models ---
# Worker: routing, tests, fixes. Critic: the written reports.
# gemini-2.5-pro has no free-tier quota; use it only with billing enabled.
# WORKER_MODEL=gemini-2.5-flash
# CRITIC_MODEL=gemini-2.5-flash

# --- Review settings ---
# Largest submission accepted, in characters:
# MAX_CODE_CHARS=20000
# Style score a fix must reach (with all tests passing) to count as done:
# PASSING_STYLE_SCORE=90
# Fix attempts before giving up:
# MAX_FIX_ROUNDS=3

# --- Limits (checked before any model call) ---
# Longest chat message accepted, in characters (default: MAX_CODE_CHARS + 5000):
# MAX_MESSAGE_CHARS=25000
# Model calls one user may make per day, across sessions. On the free tier
# (20 requests a day per model) a review takes about 4 and a fix 2-3 per round:
# MAX_MODEL_CALLS_PER_USER_PER_DAY=100
